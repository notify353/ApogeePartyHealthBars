# Historical identity only; the old single-root publisher is not supported.
# scripts/dual_distribution.py owns the exact six-root PROD package.
package-as: ApogeePartyHealthBars
manual-changelog: CHANGELOG.md
ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - .release
  - AGENTS.md
  - distribution
  - docs
  - scripts
  - tests
  - RELEASING.md
